FOODWISE_DB=backend/foodwise.sqlite3
FOODWISE_DEMO=true
FOODWISE_CORS=http://localhost:5173,http://127.0.0.1:5173
# AI prep coach runs locally with NumPy. Groq adds connected evidence curation
# in the prep coach, field station and read-only AI Kitchen Advisor.
# Keys stay on the backend. Never prefix keys with VITE_.
# Copy to .env, fill only the providers you want, then restart the backend.
# Set the exact JSON-capable model ID available in your provider account.
# Groq model checked against official model documentation on 9 Oct 2026. Plain values or quoted values; no interpolation.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
# Catalog alias verified with a live JSON generation test on 9 Oct 2026.
GEMINI_MODEL=gemini-flash-lite-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# For measured operations, use a separate database; generated practice records stay preserved.
# FOODWISE_DEMO=false
# FOODWISE_DB=backend/operations.sqlite3
